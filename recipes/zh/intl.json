{"breakfast":[{"id":"gl_bf_greek_yogurt_fruit","cuisine":"international","kcal":260,"protein":15,"carbs":30,"fat":8,"serving":{"zh":"1 碗 (~280 克)"},"name":{"zh":"水果希腊酸奶"},"ingredients":{"zh":["低脂希腊酸奶 200 克","混合新鲜莓果（草莓和蓝莓） 80 克","蜂蜜 1 大匙","奇亚籽 1 小匙（可选）","低糖格兰诺拉麦片 1 大匙（可选）"]},"steps":{"zh":["希腊酸奶盛入餐碗。","混合莓果摆在上面。","蜂蜜淋在酸奶和莓果上。","可撒奇亚籽和格兰诺拉麦片，立即食用。"]}},{"id":"gl_bf_wholegrain_pancakes_honey","cuisine":"international","kcal":275,"protein":11,"carbs":42,"fat":7,"serving":{"zh":"3 煎饼 (~180 克)"},"name":{"zh":"全麦蜂蜜煎饼"},"ingredients":{"zh":["全麦面粉 60 克","鸡蛋 1 个","低脂牛奶 100 毫升","泡打粉半小匙","香草精少许","配食用蜂蜜 1 大匙"]},"steps":{"zh":["面粉和泡打粉在碗中混合。","加入鸡蛋、牛奶和香草精，搅打至面糊顺滑无结块。","每份煎饼倒一大匙面糊到热的不粘锅。","每面煎2至3分钟至出现气泡并金黄，配蜂蜜食用。"]}},{"id":"gl_bf_protein_oatmeal_bowl","cuisine":"international","kcal":294,"protein":20,"carbs":40,"fat":6,"serving":{"zh":"1 碗 (~280 克)"},"name":{"zh":"蛋白质燕麦碗"},"ingredients":{"zh":["燕麦片 50 克","低脂牛奶 200 毫升","乳清蛋白粉 20 克（或额外蛋清替代）","肉桂粉少许","配食用香蕉片"]},"steps":{"zh":["燕麦与牛奶在小锅中用中火煮5至6分钟，边搅拌至质地浓稠。","离火，稍微放凉（1分钟）。","加入蛋白粉充分搅拌至完全溶解无结块。","撒肉桂粉，上面摆香蕉片，温热食用。"]}},{"id":"gl_bf_eggwhite_veggie_scramble","cuisine":"international","kcal":179,"protein":21,"carbs":8,"fat":7,"serving":{"zh":"1 份 (~200 克)"},"name":{"zh":"蛋清蔬菜炒蛋"},"ingredients":{"zh":["蛋清 5 个鸡蛋分量（150 克）","甜椒（切丁） 40 克","菠菜一把 30 克","洋葱碎","盐和黑胡椒","橄榄油数滴"]},"steps":{"zh":["蛋清与盐和黑胡椒在碗中打散。","锅中热几滴油，加入洋葱和甜椒炒3分钟。","加入菠菜炒1分钟至变软。","蛋清倒在蔬菜上，边搅拌边炒3至4分钟至凝固，趁热食用。"]}},{"id":"gl_bf_pb_banana_toast","cuisine":"international","kcal":291,"protein":12,"carbs":36,"fat":11,"serving":{"zh":"2 片 (~150 克)"},"name":{"zh":"花生酱香蕉吐司"},"ingredients":{"zh":["全麦面包 2 片（60 克）","花生酱 1 大匙（16 克）","香蕉（切片） 1 根中等（100 克）","肉桂粉少许","淋面用蜂蜜（可选）"]},"steps":{"zh":["面包片烤至金黄酥脆。","涂抹花生酱。","上面摆香蕉片。","撒肉桂粉，可淋蜂蜜，立即食用。"]}},{"id":"gl_bf_smoothie_bowl_granola","cuisine":"international","kcal":285,"protein":10,"carbs":50,"fat":5,"serving":{"zh":"1 碗 (~300 克)"},"name":{"zh":"格兰诺拉思慕雪碗"},"ingredients":{"zh":["冷冻混合莓果 150 克","香蕉半根","低脂酸奶 100 克","配面用低糖格兰诺拉麦片 2 大匙","奇亚籽 1 小匙（可选）"]},"steps":{"zh":["冷冻莓果、香蕉和酸奶放入搅拌机。","搅打至浓稠顺滑（如需可加少许水帮助搅打）。","倒入盛碗。","可在上面摆格兰诺拉麦片和奇亚籽，立即食用。"]}},{"id":"gl_bf_cottage_cheese_pineapple","cuisine":"international","kcal":147,"protein":16,"carbs":14,"fat":3,"serving":{"zh":"1 碗 (~200 克)"},"name":{"zh":"菠萝茅屋奶酪"},"ingredients":{"zh":["低脂茅屋奶酪 150 克","新鲜或天然果汁罐装菠萝（切块） 80 克","装饰用新鲜薄荷叶（可选）"]},"steps":{"zh":["茅屋奶酪盛入餐碗。","菠萝块摆在上面。","可用薄荷叶装饰。","立即冷食。"]}},{"id":"gl_bf_avocado_toast_egg","cuisine":"international","kcal":304,"protein":14,"carbs":26,"fat":16,"serving":{"zh":"1 片 (~180 克)"},"name":{"zh":"牛油果煎蛋吐司"},"ingredients":{"zh":["全麦面包 1 片（35 克）","牛油果泥，半个牛油果（75 克）","鸡蛋 1 个（煎蛋或水波蛋）","盐和黑胡椒","装饰用辣椒碎（可选）"]},"steps":{"zh":["面包片烤至金黄酥脆。","牛油果与盐和黑胡椒捣成泥。","涂在吐司上。","鸡蛋按喜好方式烹制，放在牛油果上，可撒辣椒碎，立即食用。"]}},{"id":"gl_bf_protein_smoothie","cuisine":"international","kcal":248,"protein":25,"carbs":28,"fat":4,"serving":{"zh":"1 杯 (~300 毫升)"},"name":{"zh":"蛋白质思慕雪"},"ingredients":{"zh":["乳清蛋白粉 25 克","低脂牛奶 250 毫升","香蕉半根","冰块"]},"steps":{"zh":["所有材料放入搅拌机。","搅打至顺滑均匀。","倒入盛杯。","立即冷食。"]}},{"id":"gl_bf_muesli_milk","cuisine":"international","kcal":270,"protein":10,"carbs":44,"fat":6,"serving":{"zh":"1 碗 (~250 克)"},"name":{"zh":"牛奶什锦麦片"},"ingredients":{"zh":["什锦麦片（燕麦片、干果和坚果） 50 克","低脂牛奶 200 毫升"]},"steps":{"zh":["什锦麦片盛入餐碗。","倒入牛奶。","静置5分钟稍微软化。","立即食用。"]}}],"lunch":[{"id":"gl_ln_grilled_chicken_salad","cuisine":"international","kcal":368,"protein":34,"carbs":22,"fat":16,"serving":{"zh":"1 碗 (~350 克)"},"name":{"zh":"烤鸡肉沙拉"},"ingredients":{"zh":["鸡胸肉 150 克","混合生菜和芝麻菜，共 100 克","圣女果（切半） 60 克","黄瓜（切丁） 60 克","橄榄油 1 小匙和意大利黑醋 1 小匙","盐和黑胡椒"]},"steps":{"zh":["鸡胸肉用盐和黑胡椒调味。","200度烤18至20分钟至全熟，静置后切片。","生菜、芝麻菜、番茄和黄瓜摆入餐碗。","鸡肉片摆在沙拉上，淋上油和醋，立即食用。"]}},{"id":"gl_ln_grilled_salmon_brown_rice","cuisine":"international","kcal":476,"protein":34,"carbs":40,"fat":20,"serving":{"zh":"1 份 配米饭 (~400 克)"},"name":{"zh":"烤三文鱼配糙米"},"ingredients":{"zh":["三文鱼片 150 克","煮熟糙米 150 克","蒸西兰花 100 克","柠檬汁 1 大匙","橄榄油 1 小匙","盐、黑胡椒和新鲜莳萝（可选）"]},"steps":{"zh":["三文鱼片用盐、黑胡椒、柠檬汁和油调味。","200度烤15至18分钟至熟透。","西兰花蒸5至6分钟至软身仍保留一点脆度。","三文鱼配西兰花摆在糙米上，可用新鲜莳萝装饰。"]}},{"id":"gl_ln_quinoa_hummus_plate","cuisine":"international","kcal":398,"protein":16,"carbs":52,"fat":14,"serving":{"zh":"1 份 (~380 克)"},"name":{"zh":"藜麦鹰嘴豆泥拼盘"},"ingredients":{"zh":["熟藜麦 150 克","鹰嘴豆泥 80 克","圣女果（切半） 60 克","黄瓜（切丁） 60 克","橄榄油 1 小匙和柠檬汁","新鲜香芹碎"]},"steps":{"zh":["熟藜麦放在餐盘中央。","旁边放鹰嘴豆泥。","番茄和黄瓜摆在盘子周围。","淋上油和柠檬汁，整体撒香芹碎食用。"]}},{"id":"gl_ln_turkey_veg_wrap","cuisine":"international","kcal":372,"protein":28,"carbs":38,"fat":12,"serving":{"zh":"1 卷 (~280 克)"},"name":{"zh":"火鸡蔬菜卷"},"ingredients":{"zh":["全麦墨西哥薄饼 1 张大号（70 克）","火鸡胸肉片 100 克","生菜丝和番茄片","芥末酱或低脂蛋黄酱 1 小匙","黄瓜薄片","盐和黑胡椒"]},"steps":{"zh":["薄饼铺在工作台上。","涂抹芥末酱或蛋黄酱。","中央摆生菜、番茄、火鸡和黄瓜，撒盐和黑胡椒。","紧紧卷起，切半食用。"]}},{"id":"gl_ln_tuna_salad_bowl","cuisine":"international","kcal":309,"protein":30,"carbs":18,"fat":13,"serving":{"zh":"1 碗 (~300 克)"},"name":{"zh":"金枪鱼沙拉碗"},"ingredients":{"zh":["水浸金枪鱼罐头（沥干） 120 克","混合生菜 80 克","圣女果（切半） 40 克","黄瓜（切丁） 40 克","甜玉米粒 30 克","橄榄油 1 小匙和柠檬汁"]},"steps":{"zh":["金枪鱼充分沥干用叉子撕碎。","与生菜、番茄、黄瓜和玉米在碗中混合。","淋上油和柠檬汁。","拌匀立即食用。"]}},{"id":"gl_ln_grilled_shrimp_quinoa","cuisine":"international","kcal":354,"protein":30,"carbs":36,"fat":10,"serving":{"zh":"1 份 (~350 克)"},"name":{"zh":"烤虾配藜麦"},"ingredients":{"zh":["大虾（去壳） 150 克","熟藜麦 150 克","圣女果（切半） 50 克","蒜 1 瓣（压碎）","柠檬汁 1 大匙和橄榄油 1 小匙","新鲜香芹碎"]},"steps":{"zh":["虾用蒜末、柠檬汁和油调味。","220度烤8至10分钟至全熟。","藜麦与圣女果混合。","虾摆在藜麦上，用香芹装饰趁热食用。"]}},{"id":"gl_ln_chicken_veg_stirfry","cuisine":"international","kcal":351,"protein":30,"carbs":24,"fat":15,"serving":{"zh":"1 份 (~350 克)"},"name":{"zh":"鸡肉蔬菜炒菜"},"ingredients":{"zh":["鸡胸肉（切片） 150 克","混合炒菜蔬菜（西兰花、胡萝卜、甜椒） 150 克","低钠酱油 1 大匙","蒜 1 瓣（压碎）和姜蓉 1 小匙","麻油数滴"]},"steps":{"zh":["蒜末和姜蓉在干锅中炒1分钟。","加入鸡肉炒4至5分钟至金黄。","加入蔬菜炒5至6分钟至熟透仍保留一点脆度。","加入酱油和麻油拌匀，趁热食用。"]}},{"id":"gl_ln_lentil_soup_bread","cuisine":"international","kcal":342,"protein":18,"carbs":54,"fat":6,"serving":{"zh":"1 碗 配面包 (~400 克)"},"name":{"zh":"全麦面包扁豆汤"},"ingredients":{"zh":["干红扁豆 60 克","胡萝卜丁和洋葱碎","蒜 1 瓣（压碎）","清淡蔬菜高汤 400 毫升","孜然粉半小匙","配食用全麦面包 1 片"]},"steps":{"zh":["洋葱、胡萝卜和蒜末在干锅中炒4分钟。","加入扁豆、高汤和孜然粉。","加盖小火煮20至25分钟至扁豆完全软化。","如需更顺滑口感可部分打浆，配面包趁热食用。"]}},{"id":"gl_ln_baked_cod_vegetables","cuisine":"international","kcal":291,"protein":32,"carbs":16,"fat":11,"serving":{"zh":"1 份 (~350 克)"},"name":{"zh":"烤鳕鱼配蔬菜"},"ingredients":{"zh":["鳕鱼片 150 克","混合蔬菜（西葫芦、甜椒、洋葱） 150 克","橄榄油 1 小匙","柠檬汁","盐、黑胡椒和百里香"]},"steps":{"zh":["鱼片和蔬菜用盐、黑胡椒、百里香和柠檬汁调味。","摆在铺纸烤盘上，整体淋上油。","200度烤18至20分钟至鱼熟透蔬菜变软。","趁热食用。"]}},{"id":"gl_ln_brown_rice_chicken_veg_bowl","cuisine":"international","kcal":419,"protein":32,"carbs":48,"fat":11,"serving":{"zh":"1 碗 (~400 克)"},"name":{"zh":"烤鸡蔬菜糙米碗"},"ingredients":{"zh":["烤鸡胸肉 130 克","煮熟糙米 150 克","混合蒸蔬菜 100 克","清淡酱油或柠檬酱汁 1 大匙"]},"steps":{"zh":["鸡胸肉用盐和黑胡椒调味。","200度烤18至20分钟至全熟，静置后切片。","蔬菜蒸8至10分钟。","米饭盛入餐碗，上面放鸡肉和蔬菜，淋上酱汁食用。"]}}],"dinner":[{"id":"gl_dn_baked_grilled_fish","cuisine":"international","kcal":303,"protein":30,"carbs":12,"fat":15,"serving":{"zh":"1 份 (~250 克)"},"name":{"zh":"烤鱼"},"ingredients":{"zh":["白身鱼片（罗非鱼或鳕鱼） 180 克","柠檬汁 1 大匙","蒜 1 瓣（压碎）","橄榄油 1 小匙","红椒粉少许、盐和黑胡椒","装饰用新鲜香芹碎"]},"steps":{"zh":["鱼片用盐、黑胡椒和红椒粉调味。","蒜末、柠檬汁和油混合，刷在鱼上。","摆在铺纸烤盘上。","200度烤15至18分钟至熟透，用香芹装饰趁热食用。"]}},{"id":"gl_dn_chicken_vegetable_soup","cuisine":"international","kcal":241,"protein":22,"carbs":18,"fat":9,"serving":{"zh":"1 碗 (~400 克)"},"name":{"zh":"鸡肉蔬菜汤"},"ingredients":{"zh":["鸡胸肉（切丁） 100 克","胡萝卜和芹菜（切丁），共 80 克","洋葱碎","清淡鸡高汤 400 毫升","盐和黑胡椒","装饰用新鲜香芹碎"]},"steps":{"zh":["洋葱、胡萝卜和芹菜在干锅中炒4至5分钟。","加入鸡肉，煮3分钟至金黄。","加入高汤，加盖小火煮15至18分钟至鸡肉和蔬菜全熟。","用盐和黑胡椒调味，用香芹装饰趁热食用。"]}},{"id":"gl_dn_light_vegetable_omelet","cuisine":"international","kcal":231,"protein":16,"carbs":8,"fat":15,"serving":{"zh":"1 煎蛋 (~220 克)"},"name":{"zh":"轻食蔬菜蛋饼"},"ingredients":{"zh":["鸡蛋 2 个和蛋清 1 个","甜椒丁和洋葱碎","菠菜一小把","低脂奶酪碎 15 克","盐和黑胡椒","橄榄油数滴"]},"steps":{"zh":["鸡蛋和蛋清与盐和黑胡椒打散。","锅中热几滴油，加入洋葱和甜椒炒3分钟至变软。","加入菠菜炒至变软。","鸡蛋倒在蔬菜上，煎3至4分钟至部分凝固，撒上奶酪，蛋饼对折，食用。"]}},{"id":"gl_dn_baked_chicken_thighs","cuisine":"international","kcal":360,"protein":30,"carbs":6,"fat":24,"serving":{"zh":"1 份 (~250 克)"},"name":{"zh":"烤鸡腿"},"ingredients":{"zh":["去皮鸡腿 2 个（200 克）","橄榄油 1 小匙","红椒粉和蒜粉各少许","盐和黑胡椒","配食用柠檬角"]},"steps":{"zh":["鸡腿用油、红椒粉、蒜粉、盐和黑胡椒调味。","摆在铺纸烤盘上。","200度烤25至30分钟至全熟金黄。","配柠檬角趁热食用。"]}},{"id":"gl_dn_greek_salad_feta","cuisine":"international","kcal":259,"protein":8,"carbs":14,"fat":19,"serving":{"zh":"1 碗 (~300 克)"},"name":{"zh":"希腊菲达奶酪沙拉"},"ingredients":{"zh":["黄瓜（切丁） 100 克","番茄（切丁） 100 克","红洋葱（切薄片）","卡拉马塔橄榄 30 克","低脂菲达奶酪 40 克","橄榄油 1 小匙和干牛至叶少许"]},"steps":{"zh":["黄瓜、番茄和红洋葱在碗中混合。","加入橄榄。","淋上油和牛至叶。","菲达奶酪捏碎撒在沙拉上，立即食用。"]}},{"id":"gl_dn_grilled_turkey_steamed_veg","cuisine":"international","kcal":308,"protein":36,"carbs":14,"fat":12,"serving":{"zh":"1 份 (~350 克)"},"name":{"zh":"烤火鸡胸配蒸蔬菜"},"ingredients":{"zh":["火鸡胸肉 180 克","混合蒸蔬菜（胡萝卜、西葫芦、四季豆） 150 克","橄榄油 1 小匙","柠檬汁","盐、黑胡椒和百里香"]},"steps":{"zh":["火鸡胸肉用盐、黑胡椒和百里香调味。","200度烤20至22分钟至全熟。","蔬菜蒸8至10分钟至软身。","火鸡配蔬菜食用，两者都淋上油和柠檬汁。"]}},{"id":"gl_dn_baked_salmon_asparagus","cuisine":"international","kcal":376,"protein":32,"carbs":8,"fat":24,"serving":{"zh":"1 份 (~300 克)"},"name":{"zh":"烤三文鱼配芦笋"},"ingredients":{"zh":["三文鱼片 150 克","芦笋 120 克","柠檬汁","橄榄油 1 小匙","盐、黑胡椒和新鲜莳萝"]},"steps":{"zh":["三文鱼片用盐、黑胡椒和柠檬汁调味。","与芦笋一起摆在铺纸烤盘上，两者都淋上油。","200度烤15至18分钟至三文鱼熟透芦笋变软。","用新鲜莳萝装饰趁热食用。"]}},{"id":"gl_dn_stuffed_peppers_turkey","cuisine":"international","kcal":324,"protein":26,"carbs":28,"fat":12,"serving":{"zh":"2 半个甜椒 (~350 克)"},"name":{"zh":"火鸡肉末酿甜椒"},"ingredients":{"zh":["大甜椒 2 个（切半去籽）","瘦火鸡肉末 120 克","熟米饭 60 克","番茄丁和洋葱碎","孜然粉少许","盐和黑胡椒"]},"steps":{"zh":["洋葱和火鸡肉末在干锅中炒5至6分钟至金黄。","与米饭、番茄、孜然粉、盐和黑胡椒混合。","填入甜椒对半中。","摆在烤盘上，200度烤25至30分钟至甜椒变软，趁热食用。"]}},{"id":"gl_dn_grilled_shrimp_skewers_salad","cuisine":"international","kcal":277,"protein":28,"carbs":12,"fat":13,"serving":{"zh":"1 份 (~300 克)"},"name":{"zh":"烤虾串配沙拉"},"ingredients":{"zh":["大虾（去壳） 150 克","混合沙拉蔬菜 100 克","圣女果","橄榄油 1 小匙和柠檬汁","蒜 1 瓣（压碎）"]},"steps":{"zh":["虾用蒜末、柠檬汁和油调味。","穿在木签上。","220度烤8至10分钟至全熟。","摆在沙拉蔬菜和圣女果上食用。"]}},{"id":"gl_dn_baked_chicken_sweet_potato","cuisine":"international","kcal":370,"protein":34,"carbs":36,"fat":10,"serving":{"zh":"1 份 (~350 克)"},"name":{"zh":"烤鸡胸肉配红薯"},"ingredients":{"zh":["鸡胸肉 150 克","红薯（切丁） 150 克","橄榄油 1 小匙","红椒粉少许、盐和黑胡椒"]},"steps":{"zh":["鸡胸肉和红薯丁用油、红椒粉、盐和黑胡椒调味。","摆在铺纸烤盘上。","200度烤20至22分钟至鸡肉熟透红薯变软。","趁热食用。"]}}],"snack":[{"id":"gl_sn_cucumber_cottage_cheese","cuisine":"international","kcal":108,"protein":10,"carbs":8,"fat":4,"serving":{"zh":"1 碗 (~180 克)"},"name":{"zh":"黄瓜配茅屋奶酪"},"ingredients":{"zh":["黄瓜（切片） 120 克","低脂茅屋奶酪 80 克","黑胡椒粉","新鲜莳萝碎（可选）","柠檬汁少许"]},"steps":{"zh":["黄瓜片摆入餐盘。","上面放茅屋奶酪。","撒黑胡椒和柠檬汁。","可用莳萝装饰，立即食用。"]}},{"id":"gl_sn_boiled_egg_thyme","cuisine":"international","kcal":137,"protein":12,"carbs":2,"fat":9,"serving":{"zh":"2 个 (~120 克)"},"name":{"zh":"百里香水煮蛋"},"ingredients":{"zh":["鸡蛋 2 个","干百里香少许","盐和黑胡椒","橄榄油数滴（可选）"]},"steps":{"zh":["鸡蛋放入没过的水中，煮沸后根据喜好煮8至10分钟。","沥干后浸入冷水冷却，剥壳。","鸡蛋切半摆入餐盘。","撒百里香、盐、黑胡椒和几滴油（可选）食用。"]}},{"id":"gl_sn_fresh_fruit_salad","cuisine":"international","kcal":133,"protein":2,"carbs":29,"fat":1,"serving":{"zh":"1 碗 (~200 克)"},"name":{"zh":"新鲜水果沙拉"},"ingredients":{"zh":["苹果（切丁） 50 克","橙子（切块） 50 克","葡萄（切半） 50 克","猕猴桃（切片） 50 克","柠檬汁少许","装饰用新鲜薄荷叶（可选）"]},"steps":{"zh":["所有水果按说明切好。","在盛碗中混合。","撒柠檬汁防止苹果氧化变色。","可用薄荷叶装饰，冷食。"]}},{"id":"gl_sn_rice_cakes_avocado","cuisine":"international","kcal":168,"protein":4,"carbs":20,"fat":8,"serving":{"zh":"1 份 (~100 克)"},"name":{"zh":"牛油果米饼"},"ingredients":{"zh":["酥脆爆米饼 2 片（20 克）","牛油果泥 60 克","圣女果（切丁） 20 克","盐和黑胡椒","辣椒碎（可选）"]},"steps":{"zh":["牛油果与盐和黑胡椒捣成泥。","牛油果泥涂在米饼上。","番茄丁摆在上面。","可撒辣椒碎，立即食用。"]}},{"id":"gl_sn_roasted_chickpeas","cuisine":"international","kcal":161,"protein":7,"carbs":22,"fat":5,"serving":{"zh":"1 碗 (~80 克)"},"name":{"zh":"烤鹰嘴豆"},"ingredients":{"zh":["罐装鹰嘴豆（沥干） 150 克","橄榄油 1 小匙","红椒粉和孜然粉各少许","盐"]},"steps":{"zh":["鹰嘴豆用厨房纸擦干。","与油、红椒粉、孜然粉和盐混合。","单层铺在铺纸烤盘上。","烤箱200度烘烤20至25分钟，中途翻面，至酥脆，稍微放凉后食用。"]}},{"id":"gl_sn_apple_peanut_butter","cuisine":"international","kcal":154,"protein":5,"carbs":20,"fat":6,"serving":{"zh":"1 碗 配蘸酱 (~180 克)"},"name":{"zh":"花生酱苹果片"},"ingredients":{"zh":["苹果（切片） 150 克","花生酱 1 大匙（16 克）","肉桂粉少许"]},"steps":{"zh":["苹果切中等厚度片。","摆入餐盘。","花生酱放在旁边作蘸酱。","撒肉桂粉，立即食用。"]}},{"id":"gl_sn_turkey_rollups","cuisine":"international","kcal":143,"protein":16,"carbs":4,"fat":7,"serving":{"zh":"1 份 (~120 克)"},"name":{"zh":"火鸡卷"},"ingredients":{"zh":["火鸡胸肉片 100 克","低脂奶油奶酪 20 克","黄瓜（切细条）","黑胡椒粉"]},"steps":{"zh":["每片火鸡肉平铺。","涂薄薄一层奶油奶酪，撒黑胡椒。","边缘放一根黄瓜条，紧紧卷起。","冷食，可切半食用。"]}},{"id":"gl_sn_edamame_sea_salt","cuisine":"international","kcal":125,"protein":11,"carbs":9,"fat":5,"serving":{"zh":"1 碗 (~100 克)"},"name":{"zh":"海盐毛豆"},"ingredients":{"zh":["冷冻带荚毛豆 150 克（或去荚 100 克）","海盐","煮沸用水"]},"steps":{"zh":["中锅中水煮沸。","加入毛豆煮4至5分钟至软身。","沥干水分。","撒海盐，温热或冷食均可。"]}},{"id":"gl_sn_mixed_nuts_dried_fruit","cuisine":"international","kcal":183,"protein":5,"carbs":16,"fat":11,"serving":{"zh":"1 碗 (~40 克)"},"name":{"zh":"混合坚果干果"},"ingredients":{"zh":["混合无盐坚果（杏仁、核桃、腰果） 25 克","干果（葡萄干、杏干） 15 克"]},"steps":{"zh":["坚果与干果在小碗中混合。","直接立即食用。"]}},{"id":"gl_sn_protein_energy_balls","cuisine":"international","kcal":158,"protein":8,"carbs":18,"fat":6,"serving":{"zh":"4 个 (~80 克)"},"name":{"zh":"蛋白质能量球"},"ingredients":{"zh":["燕麦片 30 克","花生酱 1 大匙","蜂蜜 1 大匙","乳清蛋白粉 15 克","如需可加少许水或牛奶"]},"steps":{"zh":["所有材料在碗中混合至形成粘合面团（如太干可加少许水或牛奶）。","用手捏成小球。","冷藏30分钟至变硬。","冷食。"]}}],"dessert":[{"id":"gl_ds_chia_pudding_milk","cuisine":"international","kcal":200,"protein":8,"carbs":24,"fat":8,"serving":{"zh":"1 杯 (~200 克)"},"name":{"zh":"牛奶奇亚籽布丁"},"ingredients":{"zh":["奇亚籽 3 大匙","低脂牛奶 200 毫升","蜂蜜 1 大匙","香草精少许","装饰用新鲜莓果（可选）"]},"steps":{"zh":["奇亚籽与牛奶、蜂蜜和香草精在碗中混合。","充分搅拌使奇亚籽均匀分布。","碗盖好冷藏至少4小时（过夜更佳）至质地浓稠。","食用前再次搅拌，可用新鲜莓果装饰，冷食。"]}},{"id":"gl_ds_banana_ice_cream","cuisine":"international","kcal":150,"protein":3,"carbs":30,"fat":2,"serving":{"zh":"1 碗 (~150 克)"},"name":{"zh":"天然香蕉冰淇淋"},"ingredients":{"zh":["冷冻熟香蕉 2 根中等（200 克）","低脂牛奶 2 大匙","香草精少许","肉桂粉少许（可选）"]},"steps":{"zh":["香蕉去皮切片，冷冻至少一晚。","冷冻香蕉片放入搅拌机。","加入牛奶、香草精和肉桂粉（可选），搅打至顺滑绵密。","立即以软冰淇淋质地食用，或再冷冻1小时获得更硬的质地。"]}},{"id":"gl_ds_baked_cinnamon_apple","cuisine":"international","kcal":158,"protein":1,"carbs":34,"fat":2,"serving":{"zh":"1 碗 (~180 克)"},"name":{"zh":"肉桂烤苹果"},"ingredients":{"zh":["苹果 1 个中等（去核） 180 克","肉桂粉 1 小匙","蜂蜜 1 小匙","粗切核桃 1 小匙（可选）"]},"steps":{"zh":["苹果去核，保持外形完整。","空腔中填入肉桂粉、蜂蜜和核桃（可选）。","放入小号耐热容器。","180度烤20至25分钟至变软，温热食用。"]}},{"id":"gl_ds_yogurt_berries_honey","cuisine":"international","kcal":172,"protein":10,"carbs":24,"fat":4,"serving":{"zh":"1 碗 (~200 克)"},"name":{"zh":"莓果蜂蜜酸奶"},"ingredients":{"zh":["低脂酸奶 150 克","混合新鲜莓果 60 克","蜂蜜 1 小匙"]},"steps":{"zh":["酸奶盛入餐碗。","莓果摆在上面。","整体淋上蜂蜜，立即食用。"]}},{"id":"gl_ds_oatmeal_banana_cookies","cuisine":"international","kcal":202,"protein":5,"carbs":32,"fat":6,"serving":{"zh":"3 曲奇 (~80 克)"},"name":{"zh":"燕麦香蕉曲奇"},"ingredients":{"zh":["燕麦片 40 克","熟香蕉泥 1 根中等（100 克）","肉桂粉少许","粗切核桃 1 小匙（可选）"]},"steps":{"zh":["香蕉在碗中捣成泥。","加入燕麦、肉桂粉和核桃（可选），充分混合。","混合物捏成小扁球状，摆在铺纸烤盘上。","180度烤15至18分钟至金黄，放凉后食用。"]}},{"id":"gl_ds_yogurt_fruit_popsicles","cuisine":"international","kcal":89,"protein":4,"carbs":16,"fat":1,"serving":{"zh":"1 冰棒 (~90 克)"},"name":{"zh":"酸奶水果冰棒"},"ingredients":{"zh":["低脂酸奶 60 克","混合莓果泥 30 克","蜂蜜 1 小匙"]},"steps":{"zh":["酸奶与莓果泥和蜂蜜在碗中混合。","充分搅拌至混合均匀。","倒入冰棒模具。","冷冻至少4小时至完全凝固，脱模食用。"]}},{"id":"gl_ds_strawberries_dark_chocolate","cuisine":"international","kcal":142,"protein":2,"carbs":20,"fat":6,"serving":{"zh":"1 碗 (~150 克)"},"name":{"zh":"黑巧克力草莓"},"ingredients":{"zh":["新鲜草莓 150 克","黑巧克力（70%以上，融化） 20 克"]},"steps":{"zh":["草莓洗净擦干，保留蒂部。","隔水加热或用微波炉短时间融化巧克力。","每个草莓浸入巧克力至一半。","摆在烘焙纸上，冷藏15分钟至巧克力凝固，食用。"]}},{"id":"gl_ds_light_rice_pudding","cuisine":"international","kcal":220,"protein":8,"carbs":38,"fat":4,"serving":{"zh":"1 碗 (~200 克)"},"name":{"zh":"轻食米布丁"},"ingredients":{"zh":["熟米饭（白米或糙米） 100 克","低脂牛奶 200 毫升","蜂蜜 1 大匙","香草精少许","装饰用肉桂粉少许"]},"steps":{"zh":["米饭和牛奶放入小锅用中火加热。","边持续搅拌边煮10至12分钟至质地绵密。","离火，加入蜂蜜和香草精搅拌。","撒肉桂粉，温热或冷食均可。"]}},{"id":"gl_ds_baked_pear_honey_walnuts","cuisine":"international","kcal":181,"protein":2,"carbs":32,"fat":5,"serving":{"zh":"1 个 (~180 克)"},"name":{"zh":"蜂蜜核桃烤梨"},"ingredients":{"zh":["中等梨（切半去核） 180 克","蜂蜜 1 大匙","核桃碎 1 大匙","肉桂粉少许"]},"steps":{"zh":["梨半切面朝上放入小烤盘。","淋上蜂蜜。","撒核桃碎和肉桂粉。","180度烤20至25分钟至变软，温热食用。"]}},{"id":"gl_ds_greek_yogurt_chocolate_mousse","cuisine":"international","kcal":165,"protein":12,"carbs":18,"fat":5,"serving":{"zh":"1 杯 (~150 克)"},"name":{"zh":"希腊酸奶巧克力慕斯"},"ingredients":{"zh":["低脂希腊酸奶 150 克","无糖生可可粉 1 大匙","蜂蜜 1 大匙","香草精少许"]},"steps":{"zh":["所有材料在碗中混合至质地完全顺滑无结块。","冷藏至少30分钟。","冷食。"]}}]}